{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "project-manager-frontend": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/project-manager-frontend", "index": "src/index.html", "browser": "src/main.ts",
            "polyfills": ["zone.js"], "tsConfig": "tsconfig.json", "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.css"], "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "project-manager-frontend:build",
            "host": "0.0.0.0",
            "poll": 1000,
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}
